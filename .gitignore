# Secrets — NEVER commit real keys (.env.example is the safe template)
.env

# Paper-trade state IS committed on purpose: data/*.db is how the
# scheduled GitHub Action carries positions/equity from run to run.
# Everything else under data/ (backtest dumps, logs, local archives)
# stays local.
data/*.csv
data/*.json
data/*.log
data/archive*/

__pycache__/
*.pyc
